# Clonoth Remote Worker 环境变量配置
# 复制此文件为 .env 并填入实际值，worker 启动时自动加载

# 必填：Supervisor 分配的 Worker Token
CLONOTH_WORKER_TOKEN=your_token_here

# 必填：Supervisor 地址
CLONOTH_SUPERVISOR_URL=http://your-supervisor-host:8765

# 可选：Worker 标识（默认自动用主机名）
# CLONOTH_WORKER_ID=my-pc
# CLONOTH_WORKER_NAME=My Windows PC

# 可选：日志级别 (DEBUG/INFO/WARNING)
# LOG_LEVEL=INFO
